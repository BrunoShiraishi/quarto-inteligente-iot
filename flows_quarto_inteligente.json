    {
        "id": "ca6b912f14c831bb",
        "type": "function",
        "z": "ddb24761247cea9b",
        "name": "Verificar alerta email",
        "func": "var dados = msg.payload;\n\nif (typeof dados === \"string\") {\n    dados = JSON.parse(dados);\n}\n\nif (dados.alerta === \"NORMAL\") {\n    return null;\n}\n\nvar linkPlanilha = \"https://docs.google.com/spreadsheets/d/1UVSsKeT5dNlfdqR_TrT_8rpJjFUJTBToDHLP29w9DKs/edit?gid=0#gid=0\";\n\nvar movimentoTexto = Number(dados.movimento) === 1 ? \"Presenca detectada\" : \"Sem presenca\";\nvar nivelRisco = \"Atencao\";\n\nif (dados.alerta === \"GAS DETECT\") {\n    nivelRisco = \"Risco alto - verificar possivel gas ou fumaca\";\n} else if (dados.alerta === \"TEMP ALTA\") {\n    nivelRisco = \"Risco medio - temperatura elevada\";\n} else if (dados.alerta === \"MOVIMENTO\") {\n    nivelRisco = \"Atencao - movimento identificado\";\n} else if (dados.alerta === \"AMBIENTE ESCURO\") {\n    nivelRisco = \"Aviso - baixa luminosidade\";\n}\n\nmsg.topic = \"Notificacao IoT - Quarto Inteligente\";\n\nmsg.payload =\n    \"Sistema Quarto Inteligente IoT\\n\" +\n    \"Notificacao automatica de monitoramento residencial\\n\\n\" +\n\n    \"Resumo do alerta\\n\" +\n    \"--------------------------------\\n\" +\n    \"Tipo de alerta: \" + dados.alerta + \"\\n\" +\n    \"Classificacao: \" + nivelRisco + \"\\n\" +\n    \"Data e hora: \" + new Date().toLocaleString(\"pt-BR\") + \"\\n\\n\" +\n\n    \"Leituras registradas no momento do evento\\n\" +\n    \"--------------------------------\\n\" +\n    \"Temperatura: \" + dados.temperatura + \" C\\n\" +\n    \"Umidade: \" + dados.umidade + \" %\\n\" +\n    \"Luminosidade: \" + dados.luminosidade + \" ADC\\n\" +\n    \"Gas/Fumaca: \" + dados.gas + \" ADC\\n\" +\n    \"Sensor PIR: \" + movimentoTexto + \"\\n\\n\" +\n\n    \"Acoes disponiveis no sistema\\n\" +\n    \"--------------------------------\\n\" +\n    \"O dashboard Node-RED permite acionar individualmente luz, tomada, ventilador e alarme.\\n\" +\n    \"O ESP32 tambem registra os estados dos atuadores via MQTT em tempo real.\\n\\n\" +\n\n    \"Registro completo das leituras\\n\" +\n    \"--------------------------------\\n\" +\n    \"Planilha de monitoramento:\\n\" +\n    linkPlanilha + \"\\n\\n\" +\n\n    \"Mensagem gerada automaticamente pelo sistema de automacao residencial com ESP32, MQTT e Node-RED.\";\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 660,
        "y": 200,
        "wires": [
            [
                "686e15698394b958"
            ]
        ]
