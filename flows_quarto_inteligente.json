    {
        "id": "d357de1bad8bb68b",
        "type": "function",
        "z": "ddb24761247cea9b",
        "name": "Separar status",
        "func": "var valor = msg.payload;\nvar topico = msg.topic;\n\nif (topico === \"quarto/status/luz\") {\n    return [{ payload: valor }, null, null, null];\n}\n\nif (topico === \"quarto/status/tomada\") {\n    return [null, { payload: valor }, null, null];\n}\n\nif (topico === \"quarto/status/ventilador\") {\n    return [null, null, { payload: valor }, null];\n}\n\nif (topico === \"quarto/status/alarme\") {\n    return [null, null, null, { payload: valor }];\n}\n\nreturn null;",
        "outputs": 4,
        "timeout": 0,
        "noerr": 0,
